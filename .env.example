# Copiază în .env.local pentru dezvoltare. Niciuna nu e obligatorie.

# URL-ul de bază al API-ului firmei (proxy-ul ANAF de pe site).
# Implicit: https://dezvoltaredigitala.ro/wp-json/dd/v1/firma
ANAF_API_URL=

# 1 = modul simulat pentru orice CUI (fără apel la site; CUI necunoscut → „negasit”).
# CUI-urile demo 1–12 (e-DRIVE) și 21–28 (SME Eco-Tech) sunt simulate oricum.
ANAF_MOCK=
